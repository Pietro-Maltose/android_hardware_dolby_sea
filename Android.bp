    owner: "aidl",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/soundfx/libswdapaidl.so",
            ],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    relative_install_path: "soundfx",
    prefer: true,
