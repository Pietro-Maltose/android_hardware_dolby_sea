                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

prebuilt_etc_xml {
    name: "dms-service.xml",
    owner: "aidl",
    src: "proprietary/vendor/etc/vintf/manifest/dms-service.xml",
    filename_from_src: true,
    sub_dir: "vintf/manifest",
    soc_specific: true,
}

cc_prebuilt_binary {
    name: "vendor.dolby.dms.service",
    owner: "aidl",
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/bin/hw/vendor.dolby.dms.service",
            ],
            shared_libs: [
                "vendor.dolby.dms-V1-ndk",
                "liblog",
                "libutils",
                "libbase",
                "libbinder",
                "libbinder_ndk",
                "libdapparamstorage",
                "libdmshal",
                "libdlbdsservice",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    strip: {
        none: true,
    },
    prefer: true,
    relative_install_path: "hw",
    soc_specific: true,
}

// Blobs link against libstagefright_foundation-v33.so. Instead of depending on the VNDK v33
// snapshot (may not exist on newer trees) we point that name to the ROM's own vendor copy,
// exactly what the module did (copy of libstagefright_foundation.so as -v33).
install_symlink {
    name: "libstagefright_foundation-v33.dolby",
    installed_location: "lib64/libstagefright_foundation-v33.so",
    symlink_target: "libstagefright_foundation.so",
    soc_specific: true,
}
