//
// Dolby DAX 3.12 (blobs from Motorola G57 Power / Android 16) for Redmi Note 12S "sea".
// Minimal set validated on device as a KernelSU module.

soong_namespace {
    imports: [
        "hardware/dolby",
    ],
}

cc_prebuilt_library_shared {
    name: "libdapparamstorage",
    owner: "aidl",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/libdapparamstorage.so",
            ],
            shared_libs: [
                "libcutils",
                "libutils",
                "liblog",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libdeccfg",
    owner: "aidl",
    strip: {
        none: true,
    },
